{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/analyze",
      "destination": "/api/analyze.ts"
    },
    {
      "source": "/api/download-proxy",
      "destination": "/api/download-proxy.ts"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
